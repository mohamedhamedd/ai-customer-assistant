{
  "name": "ai-customer-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/db/database.types.ts.tmp && mv src/lib/db/database.types.ts.tmp src/lib/db/database.types.ts",
    "test": "node --conditions=react-server --import tsx --test \"src/**/*.test.ts\"",
    "ingest": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/ingest.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "js-tiktoken": "^1.0.21",
    "next": "16.4.0",
    "openai": "^7.32.0",
    "pdf-parse": "^2.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
