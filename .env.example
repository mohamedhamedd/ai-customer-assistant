# Copy to .env.local and fill in. Never commit .env.local.

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown)
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=alloy
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# VOICE_MAX_MINUTES=10

# --- Supabase (local) ---------------------------------------------------------
# Run `npm run db:start`, then copy "API URL" and the secret / service_role key
# from `npx supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# --- App ----------------------------------------------------------------------
# Behind a proxy that sets the client address (Vercel, a load balancer):
# enables per-IP rate limits. Don't set it when clients reach the app directly.
# TRUST_PROXY=true
# Demo only: make save_lead and create_consultation_request fail as if the
# database were down (search still works).
# SIMULATE_DB_FAILURE=true

# DEMO_BUSINESS_SLUG=lakeside-dental
