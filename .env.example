# Copy to .env.local and fill in. Never commit .env.local.

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown)
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=alloy
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- Supabase (local) ---------------------------------------------------------
# Run `npm run db:start`, then copy "API URL" and the secret / service_role key
# from `npx supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# --- App ----------------------------------------------------------------------
# Admin sign-in (at least 8 characters). Unset: the admin is open under
# `npm run dev` and locked in a production build.
# ADMIN_PASSWORD=
# DEMO_BUSINESS_SLUG=lakeside-dental
